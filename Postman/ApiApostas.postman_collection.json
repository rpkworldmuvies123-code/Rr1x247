    {
      "name": "3. Fluxo Principal (Jogo + Apostas em sequência)",
      "item": [

        {
          "name": "Criar jogo (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// Gera código único apenas aqui — uma vez por run",
                "const d = new Date();",
                "const mm = String(d.getMinutes()).padStart(2, '0');",
                "const ss = String(d.getSeconds()).padStart(2, '0');",
                "pm.collectionVariables.set('codigoJogoTeste', 'FUT-2099-' + mm + ss);"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201 && pm.response.json().codigoJogo) {",
                "  pm.collectionVariables.set('codigoJogoTeste', pm.response.json().codigoJogo);",
                "}"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"codigoJogo\": \"{{codigoJogoTeste}}\",\n  \"dataHoraInicio\": \"2099-12-01T20:00:00Z\",\n  \"equipaCasa\": \"Benfica\",\n  \"equipaFora\": \"Porto\",\n  \"tipoCompeticao\": \"Liga Portugal\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/jogos", "host": ["{{baseUrl}}"], "path": ["api","jogos"] }
          }
        },

        {
          "name": "Obter jogo criado",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Tem CodigoJogo', () => pm.expect(pm.response.json()).to.have.property('CodigoJogo'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/jogos/{{codigoJogoTeste}}", "host": ["{{baseUrl}}"], "path": ["api","jogos","{{codigoJogoTeste}}"] }
          }
        },

        {
          "name": "[Edge] Código de jogo duplicado → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
