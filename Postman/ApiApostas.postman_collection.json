    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registar utilizador",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "if (pm.response.code === 200) {",
            "  pm.collectionVariables.set('token', pm.response.json().token);",
            "  pm.test('Token recebido no registo', () => pm.expect(pm.response.json().token).to.be.a('string'));",
            "}",
            "pm.test('Registo aceite (200) ou utilizador já existe (400)', () => {",
            "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"teste@betstrike.pt\",\n  \"password\": \"Teste123\",\n  \"nomeCompleto\": \"Utilizador Teste\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/registar", "host": ["{{baseUrl}}"], "path": ["api","auth","registar"] }
          }
        },
        {
          "name": "Login utilizador",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
