          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"teste@betstrike.pt\",\n  \"password\": \"Teste123\"\n}", "options": { "raw": { "language": "json" } } },
