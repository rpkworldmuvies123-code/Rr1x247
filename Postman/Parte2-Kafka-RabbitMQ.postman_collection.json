            "pm.test('estadoAtual = 4', () => pm.expect(pm.response.json().estadoAtual).to.equal(4));",
            "console.log('Jogo cancelado. Apostas pendentes serao anuladas e reembolsadas via RabbitMQ + trigger SQL.');"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
