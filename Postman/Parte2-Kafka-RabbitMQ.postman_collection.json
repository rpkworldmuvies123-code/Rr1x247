            "  console.log('Aposta id:', aposta.Id, '| Estado:', aposta.Estado, '(4=Anulada — reembolso emitido)');",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{apostasUrl}}/api/apostas", "host": ["{{apostasUrl}}"], "path": ["api","apostas"] }
          }
        },
