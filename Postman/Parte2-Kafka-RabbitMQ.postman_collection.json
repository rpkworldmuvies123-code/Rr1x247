          "name": "Verificar saldo reembolsado",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "var saldoAtual = pm.response.json().SaldoAtual;",
            "var saldoAntes = parseFloat(pm.collectionVariables.get('saldoAntesCancel'));",
