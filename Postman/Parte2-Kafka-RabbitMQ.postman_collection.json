          }
        },
        {
          "name": "Verificar aposta Anulada (aguardar ~3s)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "var apostas = pm.response.json();",
            "var aposta = apostas.find(a => a.Id == pm.collectionVariables.get('apostaIdCancel'));",
