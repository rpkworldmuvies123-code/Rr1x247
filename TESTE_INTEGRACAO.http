/**
 * Exemplo de dados para teste da integração
 * Executar os seguintes comandos no resto client ou Postman
 */

// 1. CRIAR JOGO 1
POST http://localhost:5141/api/jogos
Content-Type: application/json

{
  "codigoJogo": "FUT-2026-0101",
  "dataHoraInicio": "2026-04-21T15:30:00",
  "equipaCasa": "Sporting CP",
  "equipaFora": "SL Benfica",
  "tipoCompeticao": "Liga Portugal",
  "estadoAtual": 1
}

### RESPOSTA ESPERADA
201 Created
{
  "id": 1,
  "codigoJogo": "FUT-2026-0101"
}

---

